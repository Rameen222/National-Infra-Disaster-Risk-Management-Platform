PORT=7542
# CORS: origin: true (reflect any LAN origin) is set in code when NODE_ENV != production.
# For production, set CLIENT_ORIGIN to the exact URL clients use.
CLIENT_ORIGIN=http://localhost:7541
NODE_ENV=development

# Geocoding uses a Google service account (OAuth), not an API key.
# Enable "Places API (New)" in Google Cloud Console, create a service-account
# key, and point this at the JSON file. If unset, the server falls back to
# ../geekey.json (the repo root, one level above server/). Never commit the
# key (see root .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=../geekey.json
