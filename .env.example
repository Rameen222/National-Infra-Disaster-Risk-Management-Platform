# ── NIRRP environment configuration (committed template) ────
# Copy this file to .env on a fresh clone (install scripts do it for you):
#     cp .env.example .env   (Linux/Mac)
#     copy .env.example .env (Windows)
# Then edit the values below to match YOUR machine's network.
#
# ── Startup modes ────────────────────────────────────────────
# Development (this machine only):
#     start.bat  /  ./start.sh
#
# Local-network mode (accessible from other PCs on the LAN):
#     start.bat already exposes Vite on 0.0.0.0 — other PCs open
#     http://<this-machine-ip>:CLIENT_PORT in their browser.
#     Spatial processing results (risk calculator, encroachment) are
#     cached on disk so the second PC gets instant results.
#
# Production / HPC server:
#     serve.bat  /  ./serve.sh
#     → builds the frontend, starts Flask with waitress on PYBACKEND_PORT
# ─────────────────────────────────────────────────────────────

# ── GeoServer ────────────────────────────────────────────────
# IP/port of the GeoServer instance. UPDATE THIS when GeoServer moves.
# Consumed by: Vite dev proxy, Python backend, production proxy.
GEOSERVER_URL=http://172.18.1.132:8080
GEOSERVER_USER=admin
GEOSERVER_PASS=geoserver

# ── Vector tile server (tileserver-gl) ───────────────────────
# Serves per-district building tiles. UPDATE THIS when the tile server moves.
TILE_SERVER_URL=http://172.18.1.132:8081

# ── Streams Exposure service ─────────────────────────────────
# Backend that returns saved GLOFAS exposure rows + GloRiC stream
# geometries by date. Consumed by the /impact-api Vite proxy.
IMPACT_SERVICE_URL=http://172.18.1.45:5009

# ── GCOP / DEW exposure service ──────────────────────────────
# Lists saved exposures and serves per-exposure GeoJSON. Consumed
# by the /gcop-api Vite proxy. Endpoints:
#   GET /get-exposures/                       → [{ id, remarks }, ...]
#   GET /get-exposures/?exposure_id=<id>      → FeatureCollection
GCOP_EXPOSURE_URL=http://172.18.1.108:8000

# ── Local service ports ───────────────────────────────────────
# Unique non-default ports (avoids clashes with common tools on 3000/5000/8080).
# In production mode only PYBACKEND_PORT is exposed to the network.
CLIENT_PORT=7541
SERVER_PORT=7542
PYBACKEND_PORT=7543

# ── Mapbox public access token ────────────────────────────────
# Required by the map view. Public token (pk.*) — safe to commit.
# Get your own at https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=your_mapbox_token_here

# ── Buildings shapefile directory ─────────────────────────────
# Path to the folder that contains all  *_buildings.shp  files.
# Read directly by the Python backend — no GeoServer download needed.
# Windows example:  BUILDINGS_DIR=C:\HPC\buildings
# Linux example:    BUILDINGS_DIR=/data/buildings
BUILDINGS_DIR=C:\HPC\buildings
