# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.vite/

# Credentials — never commit service account keys
geekey.json
*.serviceaccount.json

# Environment variables
.env
.env.local
.env.*.local
*.local
# Keep the template committed for fresh-clone bootstrap
!.env.example
!**/.env.example

# Editor directories
.vscode/
.idea/

# Test coverage
coverage/

# Large geospatial data files
*.geojson
!client/public/**/*.geojson
!client/public/**/*.csv
!client/public/**/*.json
!client/public/**/*.qmd

# Public folder assets are required for the GIS app to run on a fresh clone
!client/public/
!client/public/**
client/public.rar
client/public.zip

# Large GIS datasets — too big for GitHub (100MB hard limit).
# These must be transferred manually (zip/cloud drive) into the same
# relative paths under client/public/ on any machine running the app.
client/public/scenario_outputs/
client/public/floodextent/
client/public/flood/
client/public/pakistan_districts.geojson
# Full road network is 651MB — over GitHub's hard limit, keep local-only.
client/public/infra/roads.geojson
# Mardan flood-sim datasets (v1 + v5, ~1.5GB combined: DEM/hillshade/depth
# PNGs, building-impact chunks, peak grids) — same "transfer manually" rule.
client/public/data/

# v5 building-impact pipeline's intermediate/working files - regenerable by
# re-running scripts/v5_impact/01-04 against the source building data, not
# meant to be committed. Contains a 190MB file that exceeds GitHub's 100MB
# hard limit on its own.
scripts/v5_impact/_work/

# Claude session data
.claude/

# Python
__pycache__/
pybackend/temp/

# Logs
server.log
pybackend.log_incoming/
