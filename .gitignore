client/public.rar
client/public.zip

# Large GIS datasets — too big for GitHub (100MB hard limit).
# These must be transferred manually (zip/cloud drive/external disk) into
# the same relative paths under client/public/ on any machine running the
# app - simplest is to just copy the whole client/public/ folder over,
# rather than hunting down each path individually (see the folders below;
# everything else in client/public/ is small enough to be tracked in git).
# Still actively used by the app, so all required for a working portal
# (gitignore comments must be their own line, not trailing, hence these
# separate lines rather than one per pattern):
# - scenario_outputs/: GCOP Exposure modal + /pyapi/simex/* backend routes
# - floodextent/: main dashboard flood-extent layer
# - flood/: main dashboard historical flood overlays (2010/2022/2025/Sus)
# - pakistan_districts.geojson: main dashboard district boundaries
client/public/scenario_outputs/
client/public/floodextent/
client/public/flood/
client/public/pakistan_districts.geojson
# Full road network is 651MB — over GitHub's hard limit, keep local-only.
# NOTE: missing from this machine's working copy as of 2026-09-08 too -
# track down wherever it was originally generated/backed up before relying
# on it existing anywhere.
client/public/infra/roads.geojson

# v5 building-impact pipeline's intermediate/working files - regenerable by
# re-running scripts/v5_impact/01-04 against the source building data, not
# meant to be committed. Contains a 190MB file that exceeds GitHub's 100MB
# hard limit on its own.
scripts/v5_impact/_work/

# Flood Vulnerability V2 (Kalpani) generated data - ~2.1GB of animation
# frames/rasters/manifests, all regenerable by re-running
# scripts/kalpani_final/01-14 against the source data in
# C:/NDMA/FLOOD_SIMULATION_FINAL. Same "too big for GitHub, transfer/
# regenerate locally" rule as the other large GIS datasets above - only the
# generating scripts are committed, not their output. (Folder was renamed
# from Data_2/ to Data_2_final/.)
client/public/Data_2_final/

# Old raw data drop, unrelated to any script in this repo
_incoming/

# Claude session data
.claude/

# Python
__pycache__/
pybackend/temp/

# Logs
server.log
pybackend.log
