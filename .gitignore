# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.vite/

# Credentials — never commit service account keys
geekey.json
*.serviceaccount.json

# Environment variables
.env
.env.local
.env.*.local
*.local
# Keep the template committed for fresh-clone bootstrap
!.env.example
!**/.env.example

# Editor directories
.vscode/
.idea/

# Test coverage
coverage/

# Defensive: geojsons are usually large exports, not meant to be committed
# anywhere in the repo. Mainly guards against one being dropped outside
# client/public/ by accident - that whole folder is excluded wholesale below
# regardless of file type.
*.geojson

# client/public/ - untracked in full (~4.5GB: GIS rasters/geojsons/CSVs,
# .glb models, scenario data). Every machine running this app needs its own
# full copy transferred manually (USB/cloud drive) into this exact path -
# see the project setup notes for the transfer steps. Was previously a mix
# of tracked small files + excluded large folders; simplified to ignore the
# whole thing since a manual full-folder copy is required either way.
# Known contents as of 2026-09-08 (for reference when setting up a new
# machine - all of it is needed for a fully working portal):
#   Data_2_final/         - Flood Vulnerability V2 (Kalpani) data, ~2.1GB,
#                            regenerable via scripts/kalpani_final/01-14
#   scenario_outputs/     - GCOP Exposure modal + /pyapi/simex/* routes
#   floodextent/          - main dashboard flood-extent layer
#   flood/                - main dashboard historical flood overlays
#   pakistan_districts.geojson - main dashboard district boundaries
#   infra/roads.geojson   - road network (~651MB) - NOTE: missing from this
#                            machine's own copy too, track down separately
#   everything else       - models/, small geojsons/CSVs/images, etc.
client/public/
client/public.rar
client/public.zip

# Old raw data drop, unrelated to any script in this repo
_incoming/

# Claude session data
.claude/

# Python
__pycache__/
pybackend/temp/

# Logs
server.log
pybackend.log

# Presentation materials — not meant for a public repo
presentation/
Flood_simulation_speaking notes.docx
Claude outputs/
